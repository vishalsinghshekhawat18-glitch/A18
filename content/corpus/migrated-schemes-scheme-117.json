      "type": "bullet_list",
      "items": [
        "Allows parents to invest for their children's future from birth to 18 years.",
        " Minimum Contribution: ₹1,000 annually.",
        " Investment Options: Default, auto, or active (equity, debt, govt. securities).",
        " Withdrawals: Partial after 3 years for education/medical needs.",
        " At 18: Converts to NPS Tier-I, with 20% withdrawal and 80% annuity.",
        " Tax Benefits: Deductions under Sections 80CCD(1) and 80CCD(1B)."
      ]
    }
